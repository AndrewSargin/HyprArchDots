{
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋋",
            "hands-free": "󰋋",
            "default": [
                "",
                "",
                ""
            ]
            },
        "on-click": "pavucontrol",
        "on-click-right": "~/.config/waybar/scripts/audio-selector.sh",
        "tooltip-format": "Output: {volume}%\n{desc}"
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": "",
        "tooltip": false
    },
    "pulseaudio.slider": {
        "min" : 0,
        "max" : 100,
        "orientation": "horizontal"
    }
}

