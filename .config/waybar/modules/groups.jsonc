{

    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true
        },
        "modules": [
            "pulseaudio",
            "pulseaudio#microphone",
            "pulseaudio/slider"
        ]
    },

    "group/shutdown": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/shutdownmenu",
            "custom/turnoff",
            "custom/reboot",
            "custom/sleep",
            "custom/logout"
        ]
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "mpris",
            "custom/media-nowplaying",
            "custom/media-time",
        ]
    },

    "group/central": {
        "orientation": "horizontal",
        "modules": [
            "group/media",
            "clock",
            "hyprland/workspaces"
        ]
    },

    "group/resources": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/resourcesmenu",
            "memory",
            "cpu",
            "temperature",
            "custom/nvidia"
        ]
    },

    "group/connections": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true,
            "click-to-reveal": false
        },
        "modules": [
            "network",
            "bluetooth"
        ]
    },

    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "group/resources",
            "custom/fcitx5",
            "battery"
        ]
    },
     
    "group/left": {
        "orientation": "horizontal",
        "modules": [
            "group/connections",
            "idle_inhibitor",
            "group/audio"
        ]
    }

}

