{
    "custom/media-nowplaying": {
        "exec": "$HOME/.config/waybar/scripts/medianowplaying.sh",
        "escape": true,
        "tooltip": false,
        "on-click-middle": "playerctl play-pause",
    	"on-click": "playerctl previous",
    	"on-click-right": "playerctl next"
    },
    
    "custom/media-time": {
        "exec": "$HOME/.config/waybar/scripts/mediatime.sh",
        "escape": true,
        "tooltip": false,
        "interval": 1,
        "on-click-middle": "playerctl play-pause",
    	"on-click": "playerctl previous",
    	"on-click-right": "playerctl next"
    },

    "custom/resourcesmenu": {
        "format": "<span font='20px'>󰇅</span>",
        "tooltip": false
    },
    
    "custom/fcitx5": {
        "exec": "$HOME/.config/waybar/scripts/fcitx5-status.sh",
        "interval": 1,
        "return-type": "json",
        "format": "{text}"
    },

    "custom/nvidia": {
        "exec": "$HOME/.config/waybar/scripts/nvidia-gpu.sh",
        "interval": 10,
        "return-type": "json",
        "format": "{}",
        "escape": false
    }

}
