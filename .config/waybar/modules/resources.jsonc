{

    "memory": {
        "interval": 10,
        "format": "{percentage}% ",
        "tooltip": false,
        "max-length": 10
    },

    "cpu": {
        "tooltip": false,
        "interval": 10,
        "format": "󰻠 {usage}%",
        "states": {
            "warning": 75,
            "critical": 90
        }
    },

    "temperature": {
        "tooltip": false,
        "interval": 10,
        "thermal-zone": 3,
        "critical-threshold": 80,
        "format": "{icon}{temperatureC}°C",
        "format-critical":"󱗗{temperatureC}°C",
        "format-icons": [
            "",
            "",    
            ""
        ]
    }

}
