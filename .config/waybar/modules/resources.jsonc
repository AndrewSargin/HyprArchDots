{

    "memory": {
        "interval": 10,
        "format": "<span font='20px'></span> <span rise='2000'>{percentage}%</span>",
        "tooltip": false,
        "max-length": 10
    },

    "cpu": {
        "tooltip": false,
        "interval": 10,
        "format": "<span font='20px'>󰻠</span> <span rise='2000'>{usage}%</span>",
        "states": {
            "warning": 75,
            "critical": 90
        }
    },

    "temperature": {
        "tooltip": false,
        "interval": 10,
        "thermal-zone": 3,
        "critical-threshold": 80,
        "format": "<span font='20px'>{icon}</span><span rise='2000'>{temperatureC}°C</span>",
        "format-critical":"󱗗{temperatureC}°C",
        "format-icons": [
            "",
            "",    
            ""
        ]
    }

}
