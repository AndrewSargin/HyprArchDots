// -*- mode: jsonc -*-
{

    "include": [
        "./modules/groups.jsonc",
        "./modules/custom.jsonc",
        "./modules/resources.jsonc",
        "./modules/shutdown.jsonc",
        "./modules/connections.jsonc",
        "./modules/modules.jsonc",
        "./modules/hyprland.jsonc",
        "./modules/clock.jsonc",
        "./modules/audio.jsonc",
    ],	

    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    //"height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 10, // Gaps between modules (4px)
    // Choose the order of the modules

    "modules-left": [
        "group/shutdown",
        "idle_inhibitor",
        "group/resources",
        "group/connections",
        "group/audio"
    ],

    "modules-center": [
        "group/media"
    ],

    "modules-right": [
        "hyprland/workspaces",
        "hyprland/submap",
        "clock",
        "tray",
        "battery"
    ]
 
}
