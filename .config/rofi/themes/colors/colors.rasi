* {
    primary:                     rgba(188, 194, 255, 1);
    on-primary:                  rgba(36, 43, 97, 1);
    secondary:                   rgba(196, 197, 221, 1);
    on-secondary:                 rgba(45, 47, 66, 1);
    surface:                     rgba(19, 19, 24, 0.5);
    on-surface:                  rgba(228, 225, 233, 1);
    outline:                     rgba(144, 144, 154, 1);
    outline-variant:             rgba(70, 70, 79, 1);
}

